# Register a test-mode app at https://evomap.ai/dev/portal
EVOMAP_CLIENT_ID=evm_client_test_replace_me
EVOMAP_CLIENT_SECRET=evm_secret_replace_me
EVOMAP_REDIRECT_URI=http://localhost:8000/oauth/callback

# Optional: paste a short-lived token here to skip the browser OAuth flow.
EVOMAP_TOKEN=

EVOMAP_SCOPES=recipe:read gene:read reuse:query recipe:write recipe:publish
EVOMAP_BASE_URL=https://evomap.ai

# Publishing is disabled unless both this flag is true and the client is test-mode.
EVOMAP_ALLOW_TEST_PUBLISH=false

# Approved test Recipe used by the MindLoop demo.
EVOMAP_RECIPE_ID=
MINDLOOP_DB_PATH=mindloop.db

# EvoMap OpenAI-compatible model gateway. Keep the real key in .env only.
AI_BASE_URL=https://api.evomap.ai/v1
AI_API_KEY=
AI_MODEL=evomap-deepseek-v4-flash
AI_TIMEOUT_SECONDS=20
AI_FALLBACK_ENABLED=true
